 VCPUscriptVar *VCPU::getOrphan(int id) {
   OrphanEntry *p = orphans.findItem((const wchar_t *)&id);
-  ASSERT(p != NULL);
+  // qtWasabi: when the bytecode references an orphan id that was
+  // never created (e.g. cross-skin reload leaves stale ids in a
+  // script, or vcpu_getMember returns an id outside the table),
+  // return a pointer to a thread-local safe-default VCPUscriptVar
+  // (SCRIPT_OBJECT/NULL).  Callers (VCPUassign, CALLM-getmember)
+  // dereference v->v.type and v->v.data.odata unconditionally; a
+  // null-object default keeps them on their existing null-receiver
+  // guard paths instead of segfaulting on (*NULL).
+  if (p == NULL) {
+    if (const char *t = ::getenv("WASABIQT_TRACE_MAKI"))
+      ::fprintf(stderr, "[orphan] getOrphan miss id=%d\n", id);
+    static thread_local VCPUscriptVar safe = {};
+    safe.v.type = SCRIPT_OBJECT;
+    safe.v.data.odata = NULL;
+    safe.varId = -1;
+    safe.scriptId = -1;
+    safe.transcient = 0;
+    return &safe;
+  }
   return &p->v;
 }
