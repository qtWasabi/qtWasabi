+  // mirrors the spirit of the original ASSERT (the entry should
+  // already be gone if we got here from a code path that already
+  // freed it).
+  if (p == NULL || pos < 0) {
+    if (const char *t = ::getenv("WASABIQT_TRACE_MAKI"))
+      ::fprintf(stderr, "[orphan] killOrphan miss id=%d\n", id);
+    return;
