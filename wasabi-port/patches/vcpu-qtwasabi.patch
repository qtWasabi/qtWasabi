+  // M14j: redirect bogus receivers to configDummy. Catches both null
+  // (unbound _predecl globals like Config) and non-object types
+  // (data.idata aliased through data.odata as a small int that the
+  // dispatcher would otherwise treat as a pointer and segfault on).
+  // Gated by env var so the byte-for-byte promise stays intact when
+  // off.
+  //
+  // qtWasabi: a var typed as SCRIPT_OBJECT (7) or any class id (>=8,
+  // also the -1 sentinel our `ObjectTable::getClassFromGuid` stub
+  // leaves for every class because we don't yet have a class registry)
+  // is "object-shaped" — the data union holds a pointer.  The original
+  // upstream check `type != SCRIPT_OBJECT` rejects every class-typed
+  // slot, including the ones the loader just bound to a real System.
+  // Accept anything outside the primitive range [SCRIPT_INT,
+  // SCRIPT_STRING] (i.e. 2..6) as a valid object receiver.
+  bool typeIsObjectShaped =
+      (object.v.type < SCRIPT_INT) || (object.v.type > SCRIPT_STRING);
+  bool bogus = (object.v.data.odata == NULL) || !typeIsObjectShaped;
+  if (bogus) {
+    static const char *fb_env = getenv("WASABIQT_CONFIG_FALLBACK");
+    if (fb_env && *fb_env == '1') {
+      if (void *dummy = wq_config_dummy_get()) {
+        object.v.type = SCRIPT_OBJECT;
+        object.v.data.odata = (ScriptObject *)dummy;
+        bogus = false;
+      }
+    }
+    if (bogus) {
+      // qtWasabi: emit the function name + sid context when
+      // WASABIQT_TRACE_NULLCALL=1, so we know which binding is being
+      // invoked with a null receiver — saves wading through a 1000-
+      // line CALLM trace to map ip back to a method name.
+      if (const char *t = ::getenv("WASABIQT_TRACE_NULLCALL");
+          t && *t == '1' && e && e->functionName) {
+        char nb[128];
+        const wchar_t *wn = e->functionName;
+        int o = 0;
+        for (; wn[o] && o < (int)sizeof(nb)-1; ++o)
+          nb[o] = (wn[o] < 128) ? (char)wn[o] : '?';
+        nb[o] = 0;
+        ::fprintf(stderr,
+            "[nullcall] sid=%d ip=%d method=%s\n",
+            VCPU::VSD, VCPU::VIP, nb);
+      }
+      Script::guruMeditation(SOM::getSystemObjectByScriptId(VCPU::VSD), GURU_NULLCALLED, L"Null object called", object.varId);
+      cpuidstack.pop(&VCC);
+      cpuidstack.pop(&VIP);
+      cpuidstack.pop(&VSD);
+      return MAKE_SCRIPT_INT(0);
+      //ASSERT(0);
+    }
