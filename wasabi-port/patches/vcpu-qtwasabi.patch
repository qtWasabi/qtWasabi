 void VCPU::killOrphan(int id) {
   int pos;
   OrphanEntry *p = orphans.findItem((const wchar_t *)&id, &pos);
-  ASSERT(p != NULL && pos >= 0);
+  // qtWasabi: when the orphan-id table is out of sync (cross-skin
